.root__KoJTP { background-color: var(--modal-background); border: 1px solid var(--border-normal); border-radius: var(--radius-md); margin: 0px auto; max-height: 100%; pointer-events: all; position: relative; }

.root__KoJTP.root__KoJTP { border-radius: var(--radius-md); }

.small__KoJTP { max-height: 720px; min-height: 220px; width: var(--modal-width-small); }

.medium__KoJTP { max-height: 800px; width: var(--modal-width-medium); }

.large__KoJTP, .medium__KoJTP { min-height: 400px; }

.large__KoJTP { max-width: 962px; min-width: var(--modal-width-large); }

