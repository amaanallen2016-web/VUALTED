* { box-sizing: border-box; scrollbar-width: thin; scrollbar-color: var(--border-2) transparent; font-family: inherit; }

::-webkit-scrollbar { width: 10px; height: 10px; }

::-webkit-scrollbar-track { background: 0px 0px; }

::-webkit-scrollbar-thumb { background-color: var(--border-2); background-clip: padding-box; border: 2px solid rgba(0, 0, 0, 0); border-radius: 999px; }

::-webkit-scrollbar-thumb:hover { background-color: var(--bg-4); }

::-webkit-scrollbar-corner { background: 0px 0px; }

:where(input[type="checkbox"]) { appearance: none; border: 1px solid var(--border-2); background: var(--bg-2); cursor: pointer; border-radius: 0.3rem; flex: 0 0 auto; place-content: center; width: 1rem; height: 1rem; transition: background-color 0.12s, border-color 0.12s; display: inline-grid; }

:where(input[type="checkbox"])::before { content: ""; clip-path: polygon(14% 44%, 0px 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%); background: rgb(0, 0, 0); width: 0.65em; height: 0.65em; transition: transform 0.12s ease-out; transform: scale(0); }

:where(input[type="checkbox"]:checked) { background: var(--accent); border-color: var(--accent); }

:where(input[type="checkbox"]:checked)::before { transform: scale(1); }

:where(input[type="checkbox"]:hover:not(:disabled)) { border-color: var(--accent); }

:where(input[type="checkbox"]:focus-visible) { outline: 2px solid var(--accent-glow); outline-offset: 2px; }

:where(input[type="checkbox"]:disabled) { cursor: not-allowed; }

:where(input[type="range"]) { appearance: none; background: var(--bg-4); cursor: pointer; border-radius: 999px; height: 0.375rem; }

:where(input[type="range"])::-webkit-slider-thumb { appearance: none; background: var(--accent); width: 0.875rem; height: 0.875rem; box-shadow: 0 0 0 3px color-mix(in srgb,var(--accent) 25%,transparent); border: 0px; border-radius: 50%; transition: transform 0.12s ease-out; }

:where(input[type="range"]:active)::-webkit-slider-thumb { transform: scale(1.15); }

:where(input[type="range"]:focus-visible) { outline: 2px solid var(--accent-glow); outline-offset: 4px; }

:where(input[type="range"]:disabled) { opacity: 0.5; cursor: not-allowed; }

:where(select) { appearance: none; cursor: pointer; background-image: linear-gradient(45deg, rgba(0, 0, 0, 0) 50%, currentcolor 50%), linear-gradient(135deg, currentcolor 50%, rgba(0, 0, 0, 0) 50%); background-position: calc(100% - 0.9rem) center, calc(100% - 0.6rem) center; background-repeat: no-repeat; background-size: 0.3rem 0.3rem; }

select:not([multiple]) { padding-right: 1.75rem; }

:where(select) option { background: var(--bg-2-base); color: var(--bright-text); }

:where(input[type="color"]) { appearance: none; cursor: pointer; background: 0px 0px; border: 0px; border-radius: 999px; padding: 0px; overflow: hidden; }

:where(input[type="color"])::-webkit-color-swatch-wrapper { padding: 0px; }

:where(input[type="color"])::-webkit-color-swatch { border: 1px solid var(--border-2); border-radius: 999px; }

:where(input[type="number"]) { appearance: textfield; }

:where(input[type="number"])::-webkit-inner-spin-button { appearance: none; margin: 0px; }

:where(input[type="number"])::-webkit-outer-spin-button { appearance: none; margin: 0px; }

