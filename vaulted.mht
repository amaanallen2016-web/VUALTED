button, input, optgroup, select, textarea { border: 0px; font-family: inherit; margin: 0px; }

button { background-color: transparent; background-image: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

button:focus { outline: none; }

[role="button"], button { cursor: pointer; }

*, ::after, ::before { box-sizing: border-box; }

ol[role="list"], ul[role="list"] { list-style: none; }

img, picture { display: block; max-width: 100%; }

